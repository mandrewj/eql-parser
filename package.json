{
  "name": "eql-parser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local DPS log parser for EverQuest Legends",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-force-exit 'src/**/*.test.ts'",
    "parse:check": "tsx src/tools/parse-check.ts",
    "report": "tsx src/tools/report.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
