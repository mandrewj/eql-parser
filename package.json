{
  "name": "eql-parser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local DPS log parser for EverQuest Legends",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch src/index.ts",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build": "npm run build:web && npm run build:standalone",
    "package:sea": "node scripts/package-sea.mjs",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-force-exit 'src/**/*.test.ts'",
    "parse:check": "tsx src/tools/parse-check.ts",
    "report": "tsx src/tools/report.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
